# Ports published on the host
FLOWKRON_BIND_HOST=127.0.0.1
LANDING_PORT=8080
APP_PORT=8081
AUTH_PORT=8000
OPERATIONAL_PORT=8001
AGENT_CORE_PORT=8002
POSTGRES_PORT=15432
REDIS_PORT=6379

# Frontends publicos locales
LANDING_PUBLIC_URL=http://localhost:8080
APP_PUBLIC_URL=http://localhost:8081
CONTACT_API_BASE_URL=http://localhost:8000
API_PUBLIC_URL=http://localhost:8000/api/v1
OPERATIONAL_API_PUBLIC_URL=http://localhost:8001/api/v1
AGENT_CORE_API_PUBLIC_URL=http://localhost:8002/api/v1
SALES_WHATSAPP_NUMBER=

# Django / auth-service
DJANGO_SETTINGS_MODULE=config.settings.base
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8000,http://127.0.0.1:8000
OPERATIONAL_CORS_ALLOWED_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","http://localhost:8080","http://127.0.0.1:8080","http://localhost:8081","http://127.0.0.1:8081","http://localhost:8000","http://127.0.0.1:8000"]
SIGNING_KEY_ENCRYPTION_KEY=replace-with-a-long-random-signing-secret
IAM_AUTO_VERIFY_USER_EMAIL=False

# Base de datos / cache
POSTGRES_DB=flowkron_auth
POSTGRES_USER=flowkron_admin
POSTGRES_PASSWORD=replace-with-a-db-password
DATABASE_URL=postgres://flowkron_admin:replace-with-a-db-password@flowkron-postgres:5432/flowkron_auth
AUTH_DATABASE_SCHEMA=auth_
OPERATIONAL_DATABASE_URL=postgresql+psycopg://flowkron_admin:replace-with-a-db-password@flowkron-postgres:5432/flowkron_auth
OPERATIONAL_DATABASE_SCHEMA=operational
OPERATIONAL_DATABASE_GRANT_ROLE=
REDIS_URL=redis://flowkron-redis:6379/0

# JWT
GENERATE_JWT_KEYS=True
JWT_AUDIENCE=flowkron
JWT_ISSUER=flowkron-auth-service
SIGNING_KEY_ENCRYPTION_SALT=flowkron-auth-service
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
OPERATIONAL_JWT_PUBLIC_KEY_PATH=/keys/jwt_public.pem
OPERATIONAL_JWT_PUBLIC_KEY=

# Comunicacion interna
OPERATIONAL_SERVICE_URL=http://flowkron-operational-service:8001
OPERATIONAL_INTERNAL_TOKEN=replace-with-a-long-random-internal-token

# Agent Core
AGENT_CORE_PERSISTENCE_MODE=operational
AGENT_CORE_ALLOW_LOCAL_DB_BOOTSTRAP=false
AGENT_CORE_JWT_PUBLIC_KEY_PATH=/keys/jwt_public.pem
AGENT_CORE_JWT_PUBLIC_KEY=
AGENT_CORE_ALLOW_INSECURE_TENANT_HEADER=false
AGENT_CORE_CORS_ALLOWED_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","http://localhost:8081","http://127.0.0.1:8081"]
AZURE_OPENAI_ENABLED=false
CHAT_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AZURE_OPENAI_API_VERSION=2024-02-01
CHAT_COMPLETION_URL=https://your-resource.openai.azure.com/openai/deployments/gpt-4o-mini/chat/completions?api-version=2024-02-01
CHAT_COMPLETION_MODEL_NAME=gpt-4o-mini
CHAT_COMPLETION_MAX_TOKENS=2000
CHAT_COMPLETION_TEMPERATURE=0.3
CHAT_COMPLETION_TIMEOUT_SECONDS=60
EMBEDDING_URL=https://your-resource.openai.azure.com/openai/deployments/text-embedding-3-small/embeddings?api-version=2024-02-01
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=60
AZURE_OPENAI_API_KEY=replace-with-azure-openai-api-key

# Bootstrap operativo
RUN_MIGRATIONS=True
RUN_SEEDS=True
RUN_COLLECTSTATIC=True
CREATE_SUPERUSER=False
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_USERNAME=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# Local mail is written to the auth container console. Enable the HTTP backend
# only with gateway credentials and a verified Resend sender. See README.md.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
MAIL_GATEWAY_URL=http://smtp-http-blandskron:8000
MAIL_INTERNAL_API_KEY=
MAIL_SENDER_KEY=flowkron
EMAIL_TIMEOUT=25
EMAIL_LOG_TOKEN_ON_FAILURE=False
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_SENDERS_JSON={}
INTERNAL_CLIENTS_JSON={}

# Optional WhatsApp lab profile. Leave both ingest values empty for pairing only.
BAILEYS_INTERNAL_TOKEN=
BAILEYS_INGEST_TENANT_CODE=
BAILEYS_INGEST_KEY=
