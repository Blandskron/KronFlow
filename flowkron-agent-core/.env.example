APP_NAME=Flowkron Agent Core
ENVIRONMENT=local
DEBUG=True
PERSISTENCE_MODE=operational
ALLOW_LOCAL_DB_BOOTSTRAP=false
OPERATIONAL_SERVICE_URL=http://flowkron-operational-service:8001
INTERNAL_TOKEN=replace-with-operational-internal-token
JWT_PUBLIC_KEY_PATH=/keys/jwt_public.pem
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
JWT_AUDIENCE=flowkron
JWT_ISSUER=flowkron-auth-service
ALLOW_INSECURE_TENANT_HEADER=false
CORS_ALLOWED_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","http://localhost:8081","http://127.0.0.1:8081"]
MAX_UPLOAD_BYTES=5242880
ALLOWED_UPLOAD_EXTENSIONS=[".pdf",".docx",".csv",".xlsx",".txt",".md"]
LOW_CONFIDENCE_THRESHOLD=0.35
CHAT_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CHAT_COMPLETION_MAX_TOKENS=2000
CHAT_COMPLETION_TEMPERATURE=0.3
CHAT_COMPLETION_TIMEOUT_SECONDS=60
