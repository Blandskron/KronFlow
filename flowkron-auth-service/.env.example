DJANGO_SETTINGS_MODULE=config.settings.base
DJANGO_SECRET_KEY=replace-with-a-local-random-secret
DJANGO_DEBUG=True
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4200,http://127.0.0.1:4200,http://localhost:8080,http://127.0.0.1:8080
JWT_AUDIENCE=flowkron
JWT_ISSUER=flowkron-auth-service
SIGNING_KEY_ENCRYPTION_SALT=flowkron-auth-service
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
SIGNING_KEY_ENCRYPTION_KEY=replace-with-a-local-signing-key-encryption-secret
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
MAIL_GATEWAY_URL=
MAIL_INTERNAL_API_KEY=
MAIL_SENDER_KEY=flowkron
EMAIL_HOST=mail.blandskron.com
EMAIL_PORT=465
EMAIL_HOST_USER=verify@example.com
EMAIL_HOST_PASSWORD=replace-with-email-password
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=verify@example.com
EMAIL_LOG_TOKEN_ON_FAILURE=False
DJANGO_SUPERUSER_EMAIL=replace-with-admin-email
DJANGO_SUPERUSER_PASSWORD=replace-with-admin-password
DJANGO_SUPERUSER_USERNAME=replace-with-admin-email
POSTGRES_USER=flowkron_admin
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_DB=flowkron_auth
DATABASE_URL=postgres://flowkron_admin:replace-with-local-db-password@localhost:5432/flowkron_auth
AUTH_DATABASE_SCHEMA=auth_
RUN_COLLECTSTATIC=True
RUN_MIGRATIONS=True
RUN_SEEDS=True
CREATE_SUPERUSER=True
GENERATE_JWT_KEYS=True
IAM_AUTO_VERIFY_USER_EMAIL=False
OPERATIONAL_SERVICE_URL=http://localhost:8001
OPERATIONAL_INTERNAL_TOKEN=replace-with-shared-operational-internal-token
APP_PUBLIC_URL=http://localhost:8081
