APP_NAME=Flowkron Operational Service
ENVIRONMENT=local
DEBUG=True
DATABASE_URL=postgresql+psycopg://flowkron_admin:replace-with-local-db-password@host.docker.internal:5432/flowkron_auth
DATABASE_SCHEMA=operational
DATABASE_GRANT_ROLE=
INTERNAL_TOKEN=replace-with-shared-operational-internal-token
JWT_PUBLIC_KEY_PATH=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
JWT_AUDIENCE=flowkron
JWT_ISSUER=flowkron-auth-service
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
TENANT_MIGRATION_VERSION=tenant_schema_v3
INGEST_RATE_LIMIT_PER_MINUTE=120
OPERATIONAL_PORT=8001
